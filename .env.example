# Entorno de la app: local | demo | staging | production.
# Si falta o no es válido, Vite dev usa local y cualquier build usa production.
VITE_APP_ENV=local

# Solo tiene efecto con VITE_APP_ENV=local, `npm run dev` y hostname local.
# En demo, staging y production el bypass admin siempre queda desactivado.
VITE_ENABLE_DEV_ADMIN_BYPASS=false

# Supabase (sin cambios en esta fase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
